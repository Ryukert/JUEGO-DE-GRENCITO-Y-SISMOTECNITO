# Copia este archivo como .env.local (no se sube a GitHub) y pon tu llave.
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Requerida para el chat: llave de console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: modelo (por omisión claude-sonnet-4-6)
ANTHROPIC_MODEL=

# Límites del chat (opcionales; estos son los valores por omisión)
# Por persona: mensajes por minuto y por día. Del juego completo: tope de mensajes por día.
CHAT_LIMITE_MINUTO=12
CHAT_LIMITE_IP_DIA=150
CHAT_LIMITE_DIARIO=3000

# Opcional: contadores compartidos entre todas las copias del servidor (Upstash o Vercel KV).
# Sin ellos, cada copia cuenta por su lado en memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
