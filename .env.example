# Copia este archivo como .env.local (no se sube a GitHub) y pon tu llave.
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Requerida para el chat: llave de console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: modelo (por omisión claude-sonnet-4-6)
ANTHROPIC_MODEL=

# Límites del chat (opcionales; estos son los valores por omisión)
# Por persona: mensajes por minuto y por día. Del juego completo: tope de mensajes por día.
CHAT_LIMITE_MINUTO=12
CHAT_LIMITE_IP_DIA=150
CHAT_LIMITE_DIARIO=3000

# ---- Grupos, maestros y evaluaciones (base de datos Supabase) ----
# Sin estas tres variables el juego funciona igual, solo se esconde el botón «Mi grupo».
# URL del proyecto: Supabase → Project Settings → API (o Data API)
SUPABASE_URL=https://jnenecohdrvvegukjbxc.supabase.co
# Llave SECRETA (sb_secret_…): Supabase → Project Settings → API Keys → Secret keys.
# Salta RLS: solo va en el servidor. NUNCA le pongas el prefijo VITE_.
SUPABASE_SECRET_KEY=
# Firma los pases de alumnos y maestros y resume los PIN. 32 caracteres o más, al azar.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si lo cambias, todos tendrán que volver a entrar y los PIN/claves ya guardados dejan de servir.
JUEGO_SECRETO=
# Opcional: zona horaria para contar «una evaluación por día» (por omisión America/Tijuana)
EVALUACION_ZONA=

# Opcional: contadores compartidos entre todas las copias del servidor (Upstash o Vercel KV).
# Sin ellos, cada copia cuenta por su lado en memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
